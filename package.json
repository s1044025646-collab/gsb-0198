{
  "name": "okrig-backend",
  "description": "Windows 本地普通克里金空间插值与留一交叉验证后端（TypeScript + Node.js + SQLite）",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "start": "node --experimental-sqlite dist/server.js",
    "dev": "node --experimental-sqlite --import tsx src/server.ts",
    "cli": "node --experimental-sqlite --import tsx src/cli.ts",
    "test": "node --experimental-sqlite --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "demo": "node --experimental-sqlite --import tsx scripts/demo.ts"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "@types/node": "^22.10.2"
  }
}
